name			vstbridge
version			0.4.0-1
architecture	x86_64
summary			"Wine bridge for Windows VST2/VST3 plug-ins (RenkuOS)"
description		"Runs Windows VST2 and VST3 plug-ins on RenkuOS by hosting them
under Wine and presenting each as a native add-on that a DAW such as Kasen loads through the normal
add-ons/media search path. Ships 'VSTBridge', a native Interface Kit application, and the
equivalent command-line 'vstbridgectl'; either one syncs a native stub per installed Windows
plug-in into add-ons/media/{vstplugins,VST3}/vstbridge. Also ships the chainloader and
bridge libraries and the Wine host they launch. This build covers VST2 and VST3; there is no
CLAP bridge yet."
packager		"rations <ehqcar@proton.me>"
vendor			"rations"
copyrights {
	"2020-2024 Robbert van der Helm (yabridge)"
	"2026 rations"
}
licenses {
	"GNU GPL v3"
}
provides {
	vstbridge = 0.4.0
	cmd:vstbridgectl = 0.4.0
}
requires {
	haiku
	wine >= 11.21
}
urls {
	"https://github.com/rations/vstbridge-renku"
}
